digraph "user_workflow" {
    rankdir=TB;
    splines=ortho;
    graph [
        fontsize=12,
        labelloc="t",
        label="",
        fontname="Helvetica",
        nodesep=1.5
    ];
    node [
        shape=plaintext,
        fontname="Helvetica",
        fontsize=11
    ];
    edge [
        color="#5465b0",
        penwidth=1.5,
        arrowsize=1.0,
        fontname="Helvetica",
        fontsize=10
    ];

    UserInput [
        label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#8aa0e0">
                <TR><TD BGCOLOR="#dfe7ff"><B>1. Your Input</B></TD></TR>
                <TR><TD ALIGN="LEFT" BALIGN="LEFT">
                    <B>params: </B> {"mu": 1.0, "sigma": 0.5, ...}<BR ALIGN="LEFT"/>
                    <B>nll_fn: </B> your loss function<BR ALIGN="LEFT"/>
                    <B>fixed: </B> ["background"] (optional)<BR ALIGN="LEFT"/>
                    <B>bounds: </B> {"mu": (0, 5)} (optional)
                </TD></TR>
            </TABLE>
        >
    ];

    ToFlatState [
        label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#8aa0e0">
                <TR><TD BGCOLOR="#dfe7ff"><B>2. Convert to FlatState</B></TD></TR>
                <TR><TD ALIGN="LEFT" BALIGN="LEFT">
                    Flatten pytree → canonical keys<BR ALIGN="LEFT"/>
                    ("mu", ): 1.0,  ("sigma", ): 0.5<BR ALIGN="LEFT"/>
                    Store treedef for reconstruction
                </TD></TR>
            </TABLE>
        >
    ];

    Partition [
        label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#8aa0e0">
                <TR><TD BGCOLOR="#dfe7ff"><B>3. Partition (if fixed params)</B></TD></TR>
                <TR><TD ALIGN="LEFT" BALIGN="LEFT">
                    <B>Free: </B> {"mu": 1.0, "sigma": 0.5}<BR ALIGN="LEFT"/>
                    <B>Fixed: </B> {"background": 100}<BR ALIGN="LEFT"/>
                    Both retain segment metadata
                </TD></TR>
            </TABLE>
        >
    ];

    Optimize [
        label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#b08054">
                <TR><TD BGCOLOR="#ffebd4"><B>4. Optimization Loop</B></TD></TR>
                <TR><TD ALIGN="LEFT" BALIGN="LEFT">
                    Update free params → combine with fixed<BR ALIGN="LEFT"/>
                    Reconstruct pytree → call your NLL<BR ALIGN="LEFT"/>
                    Gradient step → repeat until convergence
                </TD></TR>
            </TABLE>
        >
    ];

    Result [
        label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#54b080">
                <TR><TD BGCOLOR="#d4ffe7"><B>5. FitResult</B></TD></TR>
                <TR><TD ALIGN="LEFT" BALIGN="LEFT">
                    <B>params: </B> fitted pytree (same structure)<BR ALIGN="LEFT"/>
                    <B>nll: </B> minimum value<BR ALIGN="LEFT"/>
                    <B>success: </B> convergence status
                </TD></TR>
            </TABLE>
        >
    ];

    UserInput -> ToFlatState [xlabel=" fit()"];
    ToFlatState -> Partition [xlabel=" partition_state() "];
    Partition -> Optimize [xlabel=" wrapped_nll "];
    Optimize -> Result [xlabel=" to_pytree() "];

    Transform [
        label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#b054b0">
            <TR><TD BGCOLOR="#f4d4ff" ALIGN="CENTER"><B>Bounds Transform</B></TD></TR>
            <TR><TD>
                <!-- Inner table controls alignment & spacing reliably -->
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" ALIGN="CENTER">
                <TR><TD ALIGN="CENTER"><B>Unwrap: </B> bounded → unbounded</TD></TR>
                <TR><TD ALIGN="CENTER"><FONT COLOR="#666666"><I>(optimizer works here)</I></FONT></TD></TR>

                <!-- spacer row for vertical gap -->
                <TR><TD HEIGHT="6"></TD></TR>

                <TR><TD ALIGN="CENTER"><B>Wrap: </B> unbounded → bounded</TD></TR>
                <TR><TD ALIGN="CENTER"><FONT COLOR="#666666"><I>(for NLL evaluation)</I></FONT></TD></TR>
                </TABLE>
            </TD></TR>
            </TABLE>
        >
    ];

    NoteBox [
        label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#e0e0e0">
                <TR><TD BGCOLOR="#f5f5f5" ALIGN="LEFT" BALIGN="LEFT">
                    <I>Your NLL function always receives the complete pytree in bounded space!</I>
                </TD></TR>
            </TABLE>
        >
    ];

    { rank=same; Optimize; Transform; }

    Optimize -> Transform [dir="both", color="#b054b0"];
    Optimize -> NoteBox [style="dashed", dir="none", color="#999999"];
}
